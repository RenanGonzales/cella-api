ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://cella:cella@localhost:5432/cella

# Generate a real secret for production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-do-not-use-in-production
ACCESS_TOKEN_EXPIRE_DAYS=7

# Enables POST /auth/demo: a private copy of the demo household per visitor
DEMO_ENABLED=true
DEMO_TTL_HOURS=24
DEMO_MAX_SANDBOXES=500

# Receipt reading with Claude: off by default, never on demo households,
# and only for the emails listed (comma-separated JSON list)
RECEIPT_AI_ENABLED=false
ANTHROPIC_API_KEY=
RECEIPT_AI_MODEL=claude-haiku-5-5
RECEIPT_AI_EMAILS=[]
